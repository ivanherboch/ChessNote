<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 et plus : mêmes exclusions pour la sauvegarde dans le cloud et le transfert vers un nouvel appareil. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="chessduck.db" />
        <exclude domain="database" path="chessduck.db-wal" />
        <exclude domain="database" path="chessduck.db-shm" />
        <exclude domain="database" path="chessduck.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="chessduck.db" />
        <exclude domain="database" path="chessduck.db-wal" />
        <exclude domain="database" path="chessduck.db-shm" />
        <exclude domain="database" path="chessduck.db-journal" />
    </device-transfer>
</data-extraction-rules>
