<?xml version="1.0" encoding="utf-8"?>
<!--
  Sauvegarde Android (jusqu'à Android 11) : la base chessduck.db (plus de 40 Mo, surtout le catalogue des problèmes)
  dépasserait le quota de 25 Mo et ferait échouer toute la sauvegarde. Elle en est exclue : les préférences (DataStore)
  sont sauvegardées, et Paramètres > Sauvegarde hors-ligne exporte toute la progression dans un fichier.
-->
<full-backup-content>
    <exclude domain="database" path="chessduck.db" />
    <exclude domain="database" path="chessduck.db-wal" />
    <exclude domain="database" path="chessduck.db-shm" />
    <exclude domain="database" path="chessduck.db-journal" />
</full-backup-content>
